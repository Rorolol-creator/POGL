#version 450

in vec4 position;
in vec4 color;
in vec2 tex_coord; 

out vec4 out_col;
out vec2 out_tex_coord;

uniform mat4 model_matrix;
uniform mat4 model_view_matrix;
uniform mat4 projection_matrix;
uniform int is_model;
void main() {
	gl_Position = projection_matrix * model_view_matrix * model_matrix * vec4(position.xyz, 1.0);
    out_col = color;
    out_tex_coord = tex_coord;
    if (is_model == 0)
        gl_PointSize = position.w;
}
