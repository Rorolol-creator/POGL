#version 450

layout(location=0) out vec4 output_color;

in vec4 out_col;
in vec2 out_tex_coord;

uniform int is_model; 
uniform sampler2D tex;

void main() {
    if (is_model == 1) {
        output_color = texture(tex, out_tex_coord);
        return;
    }
    vec2 coord = gl_PointCoord - vec2(0.5);
    float dist = length(coord);
    if (dist > 0.5)
        discard; // discard corners → makes it a circle

    // soft edge (bubble effect)
    float alpha = 1.0 - smoothstep(0.2, 0.5, dist);
    output_color = vec4(out_col.rgb, out_col.a * alpha);
}
